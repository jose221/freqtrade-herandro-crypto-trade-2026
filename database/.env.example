# =============================================================================
# Variables de entorno para la conexión PostgreSQL de Freqtrade
# Copiar este archivo como .env y completar los valores reales
# NUNCA commitear el archivo .env al repositorio
# =============================================================================

# URL de conexión PostgreSQL (formato SQLAlchemy)
# postgresql+psycopg2://usuario:contraseña@host:puerto/nombre_base_datos
FREQTRADE_DB_URL=postgresql+psycopg2://freqtrade_user:cambiar_password@localhost:5432/freqtrade_db

# Configuración del pool de conexiones
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Modo debug SQL (true solo en desarrollo)
DB_ECHO=false

# Credenciales PostgreSQL (para crear la base de datos con el script de setup)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=freqtrade_db
POSTGRES_USER=freqtrade_user
POSTGRES_PASSWORD=cambiar_password
